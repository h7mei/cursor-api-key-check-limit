#!/usr/bin/env bash
set -euo pipefail

readonly API_URL="https://api.cursor.com/v1/me"
readonly TIMEOUT=15

API_KEY="${1:-${CURSOR_API_KEY:-}}"

if [[ $# -gt 1 ]]; then
  echo "error: usage: check-key [API_KEY]" >&2
  exit 1
fi

if [[ -z "$API_KEY" ]]; then
  echo "error: no API key (pass argument or set CURSOR_API_KEY)" >&2
  exit 1
fi

TMP_BODY="$(mktemp)"
TMP_HEADERS="$(mktemp)"
trap 'rm -f "$TMP_BODY" "$TMP_HEADERS"' EXIT

CURL_OK=0
CURL_META="$(
  curl -sS \
    -o "$TMP_BODY" \
    -D "$TMP_HEADERS" \
    -w "%{http_code} %{time_total}" \
    --max-time "$TIMEOUT" \
    -u "${API_KEY}:" \
    "$API_URL" \
    2>/dev/null
)" && CURL_OK=1 || CURL_OK=0

if [[ "$CURL_OK" -ne 1 || -z "$CURL_META" ]]; then
  HTTP_CODE="000"
  TIME_TOTAL="0"
else
  HTTP_CODE="${CURL_META%% *}"
  TIME_TOTAL="${CURL_META#* }"
fi

header_value() {
  local name="$1"
  awk -v key="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')" '
    BEGIN { FS = ":[[:space:]]*" }
    {
      line = $0
      sub(/\r$/, "", line)
      if (line == "") next
      split(line, parts, FS)
      name = parts[1]
      val = line
      sub(/^[^:]*:[[:space:]]*/, "", val)
      if (tolower(name) == key) {
        print val
        exit
      }
    }
  ' "$TMP_HEADERS" 2>/dev/null || true
}

RETRY_AFTER=""
if [[ "$HTTP_CODE" == "429" ]]; then
  RETRY_AFTER="$(header_value "retry-after")"
  if [[ -z "$RETRY_AFTER" ]]; then
    RETRY_AFTER="$(header_value "x-ratelimit-reset")"
  fi
fi

BODY="$(cat "$TMP_BODY")"

if command -v python3 >/dev/null 2>&1; then
  BODY="$BODY" HTTP_CODE="$HTTP_CODE" TIME_TOTAL="$TIME_TOTAL" RETRY_AFTER="$RETRY_AFTER" python3 - <<'PY'
import json, os

body = os.environ.get("BODY") or ""
http_code = os.environ["HTTP_CODE"]
time_total = os.environ.get("TIME_TOTAL") or ""
retry_after = os.environ.get("RETRY_AFTER") or ""

try:
    data = json.loads(body) if body.strip() else {}
except json.JSONDecodeError:
    data = {}

def get(*keys, default="-"):
    for k in keys:
        if k in data and data[k] not in (None, ""):
            return data[k]
    return default

print(f"valid:        {'yes' if http_code == '200' else 'no'}")
print(f"http_status:  {http_code}")
if time_total:
    try:
        print(f"latency_s:    {float(time_total):.3f}")
    except ValueError:
        print(f"latency_s:    {time_total}")
if retry_after:
    print(f"retry_after:  {retry_after}")

if http_code == "200":
    print(f"api_key_name: {get('apiKeyName')}")
    print(f"created_at:   {get('createdAt')}")
    print(f"user_id:      {get('userId')}")
    print(f"user_email:   {get('userEmail')}")
    first = get("userFirstName", default="")
    last = get("userLastName", default="")
    name = (f"{first} {last}").strip() or "-"
    print(f"user_name:    {name}")
elif body.strip():
    msg = data.get("message") or data.get("error") or body.strip()[:200]
    print(f"error:        {msg}")
PY
else
  echo "valid:        $([ "$HTTP_CODE" = "200" ] && echo yes || echo no)"
  echo "http_status:  $HTTP_CODE"
  echo "latency_s:    $TIME_TOTAL"
  [[ -n "$RETRY_AFTER" ]] && echo "retry_after:  $RETRY_AFTER"
  if [[ "$HTTP_CODE" == "200" ]]; then
    grep -oE '"apiKeyName"[[:space:]]*:[[:space:]]*"[^"]*"' <<<"$BODY" \
      | head -1 \
      | sed 's/.*"apiKeyName"[[:space:]]*:[[:space:]]*"//;s/"$//' \
      | awk '{print "api_key_name: " $0}'
    grep -oE '"createdAt"[[:space:]]*:[[:space:]]*"[^"]*"' <<<"$BODY" \
      | head -1 \
      | sed 's/.*"createdAt"[[:space:]]*:[[:space:]]*"//;s/"$//' \
      | awk '{print "created_at:   " $0}'
    grep -oE '"userEmail"[[:space:]]*:[[:space:]]*"[^"]*"' <<<"$BODY" \
      | head -1 \
      | sed 's/.*"userEmail"[[:space:]]*:[[:space:]]*"//;s/"$//' \
      | awk '{print "user_email:   " $0}'
  elif [[ -n "$BODY" ]]; then
    echo "error:        $(printf '%s' "$BODY" | tr -d '\n' | head -c 200)"
  fi
fi

case "$HTTP_CODE" in
  200) exit 0 ;;
  429) exit 2 ;;
  000) exit 3 ;;
  *) exit 1 ;;
esac
